source "https://rubygems.org"

# La gemma "github-pages" allinea la versione locale di Jekyll e dei plugin
# a quella usata realmente da GitHub Pages in produzione, cosi' quello che
# funziona in locale con `bundle exec jekyll serve` funziona anche online.
gem "github-pages", group: :jekyll_plugins

# Richiesto perche' Ruby >= 3.0 non include piu' webrick di default, ed e'
# usato dal server di sviluppo `jekyll serve`.
gem "webrick", "~> 1.8"
